+let locationPromise = null;
+
+// Kicks off a GPS fix as soon as the page loads, in parallel with the
+// employee lookup, so it's usually already resolved by the time the
+// employee finishes typing their PIN. Resolves to null (never rejects)
+// if location is unavailable, denied, or too slow - the server decides
+// what to do with a missing location.
+function startLocationCapture(timeoutMs = 12000) {
+    return new Promise((resolve) => {
+        if (!navigator.geolocation) return resolve(null);
+        let settled = false;
+        const done = (val) => { if (!settled) { settled = true; resolve(val); } };
+        const timer = setTimeout(() => done(null), timeoutMs);
+        navigator.geolocation.getCurrentPosition(
+            (pos) => { clearTimeout(timer); done({ lat: pos.coords.latitude, lng: pos.coords.longitude, accuracy: pos.coords.accuracy }); },
+            () => { clearTimeout(timer); done(null); },
+            { enableHighAccuracy: true, timeout: timeoutMs, maximumAge: 0 }
+        );
+    });
+}
 
