+// BUG THIS FIXES: every full page refresh reset the Payroll page's
+// Month filter back to the current month (see initializeApp()), no
+// matter which month/cutoff the admin was actually working in. Since
+// deductions entered via the "Edit Deductions" modal are keyed by
+// employeeId|startDate|endDate (see getAdjustmentKey() below), landing
+// back on the wrong period after a refresh made deductions that were
+// genuinely saved for last month's cutoff look like they'd vanished -
+// they were still in localStorage, just filed under a period the page
+// was no longer showing. These two functions remember the last
+// month/period the admin had selected so a refresh returns to the
+// same view instead of silently jumping to "today".
+function savePayrollFilterState() {
+    const month = document.getElementById('payrollMonthFilter')?.value;
+    const period = document.getElementById('payrollPeriodFilter')?.value;
+    if (!month) return;
+    localStorage.setItem(STORAGE_KEYS.PAYROLL_FILTER, JSON.stringify({ month, period }));
+}
+
+function restorePayrollFilterState() {
+    try {
+        return JSON.parse(localStorage.getItem(STORAGE_KEYS.PAYROLL_FILTER) || 'null');
+    } catch {
+        return null;
+    }
+}
